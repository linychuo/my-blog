<article>
    <header class="article-header">
        <h1 class="article-title">{{title}}</h1>
        <div class="article-meta"><time datetime="{{date_time}}">{{date_time}}</time>
            <div class="article-tags">{{{tags}}}</div>
        </div>
    </header>
    <div class="article-content">{{{content}}}</div>
</article>
